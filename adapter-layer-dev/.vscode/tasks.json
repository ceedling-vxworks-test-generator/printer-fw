{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: configure adapter-layer-dev",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "cmake: build adapter_inout_test",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--target", "adapter_inout_test"
            ],
            "dependsOn": "cmake: configure adapter-layer-dev",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
