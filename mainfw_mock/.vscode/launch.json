{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug mainfw_mock",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/mainfw_mock",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "gdbの見やすい表示(pretty-printing)を有効にする",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    // これが無いと、コンテナ/WSL等の制限された環境で
                    //   warning: gdb failed to set controlling terminal: Operation not permitted
                    // が出て起動できない場合がある。
                    "description": "シェル経由の起動を無効化する(制御端末エラーの回避)",
                    "text": "set startup-with-shell off",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake: build mainfw_mock"
        }
    ]
}
