# 機密情報（絶対にコミットしない）
.env
.env.*
*.key
*.pem
secrets/
credentials*.json

# 依存・ビルド成果物
node_modules/
dist/
build*/
# mainfw-mock / mainfw_mock 直下へ手動配置される printer-fw のライブラリ本体(生成物)
/mainfw-mock/lib/
/mainfw-mock/include/
/mainfw_mock/lib/
/mainfw_mock/include/
__pycache__/
*.pyc
.venv/
venv/
target/

# C/C++ ビルド成果物
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe
*.out
*.gcno
*.gcda
CMakeCache.txt
CMakeFiles/
cmake-build-*/
compile_commands.json

# OS / エディタ
.DS_Store
Thumbs.db
# .vscode/ はチーム共有のデバッグ設定(launch.json/tasks.json)だけ追跡し、それ以外(個人設定等)は無視する
# (サブプロジェクト配下の .vscode/ にも同じ扱いを適用する)
**/.vscode/*
!**/.vscode/launch.json
!**/.vscode/tasks.json
.idea/

# ログ・一時ファイル
*.log
tmp/
.cache/
