{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug rim_capi_smoke",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/rim_capi_smoke",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            // Linux既定は /usr/bin/gdb。macOS(lldb派)なら MIMode を "lldb" に、
            // gdbが別パスにある場合は miDebuggerPath をそのパスに合わせて変更すること。
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "gdbの見やすい表示(pretty-printing)を有効にする",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    // これが無いと、WSL/コンテナ等の制限された環境で
                    //   warning: gdb failed to set controlling terminal: Operation not permitted
                    // が出てプログラムが起動せず、ブレークポイントにも到達しない。
                    // gdbがシェル経由での起動をやめることで制御端末の設定自体を回避する。
                    "description": "シェル経由の起動を無効化する(制御端末エラーの回避)",
                    "text": "set startup-with-shell off",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake: build rim_capi_smoke (Debug)"
        }
    ]
}
