<mxfile host="app.diagrams.net" agent="printer-fw design" version="24.0.0">
  <diagram name="1-全体レイヤ構成" id="page-layers">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="L_title" value="printer-fw 全体レイヤ構成（依存は上位→下位の一方向）" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="120" y="20" width="520" height="30" as="geometry"/></mxCell>
        <mxCell id="L_drv" value="Driver Layer（機種依存・ISR）&#10;HW I/O → 生値を Raw に書込" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="200" y="70" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="L_raw" value="① Raw Data Layer（core）&#10;データ辞書：型非依存ストア・全静的確保・O(1)" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="160" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="L_abs" value="② Abstract State Layer（core+model）&#10;評価器レジストリ：生データ→意味のある状態" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="250" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="L_mon" value="③ State Monitor Layer（core+model）&#10;変化検知（変化時のみ）＋ 主系FSM" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="340" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="L_obs" value="④ Observer / Event Dispatcher（core）&#10;Subscribe / Unsubscribe / Notify（中央集約）" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="430" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="L_app" value="Application Modules（購読者）&#10;UI / Log / 印刷制御 / 通信 / 保守" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="200" y="520" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="L_port" value="Port 層（port/）&#10;critical section / time / assert / log&#10;（bare-metal / RTOS）" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="610" y="160" width="190" height="330" as="geometry"/></mxCell>
        <mxCell id="L_model" value="Model Descriptor（models/）&#10;pf_model_t&#10;記述子表・評価器・FSM表・glue&#10;→ core に登録（依存性逆転）" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="140" height="330" as="geometry"/></mxCell>
        <mxCell id="Le1" style="endArrow=block;html=1;" edge="1" parent="1" source="L_drv" target="L_raw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="Le2" style="endArrow=block;html=1;" edge="1" parent="1" source="L_raw" target="L_abs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="Le3" style="endArrow=block;html=1;" edge="1" parent="1" source="L_abs" target="L_mon"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="Le4" style="endArrow=block;html=1;" edge="1" parent="1" source="L_mon" target="L_obs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="Le5" value="状態変化イベント" style="endArrow=block;html=1;" edge="1" parent="1" source="L_obs" target="L_app"><mxGeometry relative="1" as="geometry"/></mxCell>
