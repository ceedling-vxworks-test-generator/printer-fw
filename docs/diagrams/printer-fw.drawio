        <mxCell id="Fe6" value="復帰成功" style="endArrow=block;html=1;" edge="1" parent="1" source="F_rec" target="F_ready"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="Fe7" value="復帰失敗" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="F_rec" target="F_err"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="430"/><mxPoint x="420" y="430"/></Array></mxGeometry></mxCell>
        <mxCell id="F_legend" value="※ ERROR→PRINTING の直接遷移は不許可。必ず RECOVERY を経由する。" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="500" height="20" as="geometry"/></mxCell>
