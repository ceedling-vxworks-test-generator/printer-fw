        <mxCell id="Fe0" style="endArrow=block;html=1;" edge="1" parent="1" source="F_init" target="F_ready"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="Fe1" value="印刷開始" style="endArrow=block;html=1;" edge="1" parent="1" source="F_ready" target="F_print"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="Fe2" value="印刷完了" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="F_print" target="F_ready"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="230"/><mxPoint x="140" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="Fe3" value="異常検知" style="endArrow=block;html=1;" edge="1" parent="1" source="F_print" target="F_err"><mxGeometry relative="1" as="geometry"/></mxCell>
