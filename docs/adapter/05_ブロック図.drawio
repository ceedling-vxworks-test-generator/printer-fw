<mxfile host="Claude" agent="drawio-gen" version="28.1.2">
  <diagram name="Adapter実装ブロック図" id="adapter-block-diagram">
    <mxGraphModel dx="1400" dy="1440" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2140" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="t1" value="Adapter(L1) 実装ブロック図 — 現行(printer-fw)　IN/OUT・内部処理ステップ・参照データを網羅" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1600" height="30" as="geometry" />
        </mxCell>

        <!-- ===== Band1: IN ===== -->
        <mxCell id="b1bg" value="呼び出し元（IN）— 2つの入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1620" height="190" as="geometry" />
        </mxCell>
        <mxCell id="b1_capi" value="C API 利用者（mainFW / C言語）&lt;br&gt;&lt;br&gt;RIManager_Push(dataId, value, ctx)&lt;br&gt;RIManager_TestInjectDouble(dataId, value)&lt;br&gt;RIManager_TestInjectInt32(dataId, value)&lt;br&gt;RIManager_TestInjectBool(dataId, value)&lt;br&gt;※TestInject系は ctx=nullptr 固定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="95" width="310" height="130" as="geometry" />
        </mxCell>
        <mxCell id="b1_cpp" value="C++ 直接呼び出し&lt;br&gt;&lt;br&gt;context-&gt;adapter.Push(id, raw, ctx?)&lt;br&gt;&lt;br&gt;adapter は RIManagerContext が保持する&lt;br&gt;rim::RawDataInput のインスタンス&lt;br&gt;(構造体/配列を渡せるのはこちらのみ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="410" y="95" width="310" height="130" as="geometry" />
        </mxCell>
        <mxCell id="b1_in" value="IN情報（RawDataInput::Push の引数）&lt;br&gt;&lt;br&gt;id  : RIMDataId — データ識別子（機種側定義・全11種、加工せず素通し）&lt;br&gt;raw : RawValue — Scalar(double) / Struct(参照) / Array(参照) のいずれか（非所有・Push呼び出し中のみ有効）&lt;br&gt;ctx : const DataContext*（省略可、既定nullptr）— unit / faultState / scaleX1000 / key（いずれもoptional）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="750" y="95" width="880" height="130" as="geometry" />
        </mxCell>

        <!-- ===== Band2: C API shim ===== -->
        <mxCell id="b2bg" value="C API 層 — core/common/src/rim_api.cpp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="1620" height="170" as="geometry" />
        </mxCell>
        <mxCell id="b2_inject" value="InjectRaw(dataId, value, ctx)&lt;br&gt;&lt;br&gt;① rim_context_t → rim::DataContext へ変換（has_unit等で判定）&lt;br&gt;② value(double) を RawValue::Scalar(value) へラップ&lt;br&gt;③ g_context-&gt;adapter.Push(id, raw, ctx?) を呼ぶ&lt;br&gt;④ kOk→RI_SUCCESS ／ それ以外→RI_INVALID_PARAMETER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="305" width="440" height="105" as="geometry" />
        </mxCell>
        <mxCell id="b2_singleton" value="g_context（プロセス内シングルトン）&lt;br&gt;&lt;br&gt;nullptr なら即 RI_NOT_INITIALIZED&lt;br&gt;を返す（Adapterへは到達しない）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="550" y="305" width="280" height="105" as="geometry" />
        </mxCell>
        <mxCell id="b2_note" value="C APIの value は double 1本のみ。&lt;br&gt;構造体/配列(RawValue::Struct/Array)を渡すには&lt;br&gt;C++側 RawDataInput::Push を直接呼ぶ必要がある（→ 左上B1）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="305" width="760" height="105" as="geometry" />
        </mxCell>

        <!-- ===== Band3: Core Adapter ===== -->
        <mxCell id="b3bg" value="Core Adapter — core/adapter/（RawDataInput）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="1620" height="400" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="① resolver_.SelectRule(id)&lt;br&gt;→ const IRule*&lt;br&gt;&lt;br&gt;nullptr なら&lt;br&gt;kErrConvert で早期return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="495" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="② RIMDataItem item{}&lt;br&gt;item.id = id&lt;br&gt;&lt;br&gt;ctx!=nullptr なら item.context=*ctx&lt;br&gt;NULLなら既定値を入れず空のまま" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="495" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="③ rule-&gt;Convert(&lt;br&gt;  raw, item.context)&lt;br&gt;→ optional&lt;RIMValue&gt;&lt;br&gt;&lt;br&gt;nullopt なら kErrConvert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="495" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="④ item.value = *value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="495" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="⑤ port_.Post(item)&lt;br&gt;→ RIMResult を&lt;br&gt;そのまま戻り値に" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1070" y="495" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="if_resolver" value="IRuleResolver（interface）&lt;br&gt;SelectRule(RIMDataId) const&lt;br&gt;→ const IRule*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="615" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="if_members" value="RawDataInput が保持する参照&lt;br&gt;ICentralInputPort&amp;amp; port_&lt;br&gt;const IRuleResolver&amp;amp; resolver_&lt;br&gt;（コンストラクタで注入）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="615" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="if_rule" value="IRule（interface）&lt;br&gt;Convert(RawValue,DataContext) const&lt;br&gt;→ optional&lt;RIMValue&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="615" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="if_dc" value="DataContext（参照する型）&lt;br&gt;unit / faultState /&lt;br&gt;scaleX1000 / key&lt;br&gt;（全てoptional）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="615" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="if_port" value="ICentralInputPort（interface）&lt;br&gt;Post(RIMDataItem)&lt;br&gt;→ RIMResult" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1070" y="615" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="rv_box" value="RawValue（受理する生値の型）&lt;br&gt;kind: kScalar(double) / kBytes(構造体・配列, 先頭ptr+size+count, 非所有参照)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="725" width="430" height="95" as="geometry" />
