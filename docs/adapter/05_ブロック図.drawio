        <mxCell id="e_b2inject_s1" value="adapter.Push()" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#2d6cdf;" edge="1" parent="1" source="b2_inject" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>

