        <mxCell id="e_s3_rv" value="rawを参照" style="endArrow=open;html=1;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="s3" target="rv_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s2_item" value="itemを構築" style="endArrow=open;html=1;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="s2" target="item_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s5_result" value="戻り値の型" style="endArrow=open;html=1;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="s5" target="result_box"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== Band4: products/printer_a concrete impls ===== -->
        <mxCell id="b4bg" value="機種側の実体（products/printer_a/DataItem/）— IRuleResolver / IRule の具象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="1620" height="250" as="geometry" />
        </mxCell>
        <mxCell id="b4_table" value="PrinterADataProfile（IRuleResolver実装）&lt;br&gt;id → Rule 対応表（id添字のO(1)配列）&lt;br&gt;&lt;br&gt;kTemperatureSensorA/B → TemperatureRule&lt;br&gt;kHumiditySensor, kStapleLevel, kTonerLevel → PercentRule&lt;br&gt;kUpperDoorOpen, kRightDoorOpen, kLeftDoorOpen, kJobActive → BoolRule&lt;br&gt;kJobId → CountRule&lt;br&gt;&lt;br&gt;RIMDataId増減で行数不一致ならビルドで検知（static_assert）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="905" width="560" height="195" as="geometry" />
        </mxCell>
        <mxCell id="r_temp" value="TemperatureRule&lt;br&gt;単位(℃/℉/正規化済)→絶対温度K&lt;br&gt;ctx.unit未指定は kNormalized 扱い" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="905" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="r_pct" value="PercentRule&lt;br&gt;0〜100へクランプ&lt;br&gt;double→int32変換" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="930" y="905" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="r_bool" value="BoolRule&lt;br&gt;!=0 判定でboolへ変換" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="1000" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="r_cnt" value="CountRule&lt;br&gt;double→uint32変換" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="930" y="1000" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="b4_note" value="Rule実体は状態を持たないため、id横断で共有する&lt;br&gt;静的単一インスタンスとして保持。&lt;br&gt;&lt;br&gt;GetProductRuleResolver()&lt;br&gt;（products/printer_a/Pipeline/PrinterAProductBinding.cpp）&lt;br&gt;が PrinterADataProfile の静的インスタンスを返し、&lt;br&gt;RIManagerContext構築時に一度だけ取得して&lt;br&gt;RawDataInputへ注入する。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="905" width="440" height="195" as="geometry" />
        </mxCell>

        <mxCell id="e_table_rtemp" style="endArrow=open;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="b4_table" target="r_temp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_table_rpct" style="endArrow=open;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="b4_table" target="r_pct"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_table_rbool" style="endArrow=open;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="b4_table" target="r_bool"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_table_rcnt" style="endArrow=open;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="b4_table" target="r_cnt"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_ifresolver_table" value="実装" style="endArrow=open;html=1;dashed=1;strokeColor=#6c8ebf;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="if_resolver" target="b4_table"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ifrule_rtemp" value="実装（4種）" style="endArrow=open;html=1;dashed=1;strokeColor=#6c8ebf;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="if_rule" target="r_temp"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== Band5: OUT to L2 ===== -->
        <mxCell id="b5bg" value="OUT — L2 Datastoreへの受け渡し" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1130" width="1620" height="170" as="geometry" />
        </mxCell>
        <mxCell id="qip" value="QueueInputPort（ICentralInputPort実装）&lt;br&gt;Post(item): queue_.Push(item); return kOk;&lt;br&gt;（常にkOkを返す。満杯なら黙って最古を破棄）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="1175" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="siq" value="StoreInputQueue&lt;br&gt;= FixedQueue&lt;RIMDataItem, kStoreQueueDepth&gt;&lt;br&gt;固定容量リング。満杯時は最古を破棄（DroppedCount()で観測可）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="1175" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="→ L2 DataStoreWorker&lt;br&gt;（別スレッドが非同期に消費）&lt;br&gt;faultState有無で異常/現在値へ分岐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="810" y="1175" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b5_note" value="呼び出し元への戻り値はRIMResultのみ。Post自体は&lt;br&gt;失敗を通知しない（QueueInputPortは常にkOk）。&lt;br&gt;→ 満杯によるドロップは呼び出し元から見えない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="1175" width="450" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e_qip_siq" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="qip" target="siq"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_siq_l2" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="siq" target="l2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ifport_qip" value="実装" style="endArrow=open;html=1;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="if_port" target="qip"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== Dead code side panel ===== -->
        <mxCell id="deadbg" value="&lt;b&gt;⚠ 未使用・未配線のコード（参考）&lt;/b&gt;&lt;br&gt;&lt;br&gt;core/adapter/include/IHardwareAdapter.hpp&lt;br&gt;core/adapter/include/AdapterDispatcher.hpp&lt;br&gt;core/adapter/include/MockAdapter.hpp&lt;br&gt;products/printer_a/Adapter/PrinterAdapter.hpp&lt;br&gt;&lt;br&gt;PrinterAdapter::Poll() は&lt;br&gt;DeviceEvent{kTemperatureSensorA, 30}を&lt;br&gt;ハードコードして返すだけのスタブ。&lt;br&gt;&lt;br&gt;AdapterDispatcher::Dispatch(DeviceEvent) は&lt;br&gt;IRuleによる正規化を一切通さず、&lt;br&gt;doubleへキャストしてStoreInputQueueへ&lt;br&gt;直接Pushする（正規化なし）。&lt;br&gt;&lt;br&gt;本フロー（RawDataInput経由）からは&lt;br&gt;一切呼ばれていない。ビルド対象では&lt;br&gt;あるが実行経路には含まれない。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;dashed=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1700" y="450" width="380" height="850" as="geometry" />
        </mxCell>

        <!-- ===== Cross-band call flow edges ===== -->
