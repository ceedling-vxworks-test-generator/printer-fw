        <mxCell id="e_s1_ifr" value="型として参照" style="endArrow=open;html=1;dashed=1;strokeColor=#6c8ebf;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="if_resolver"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s2_ifdc" value="参照" style="endArrow=open;html=1;dashed=1;strokeColor=#6c8ebf;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="if_dc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s3_ifrule" value="型として参照" style="endArrow=open;html=1;dashed=1;strokeColor=#6c8ebf;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="if_rule"><mxGeometry relative="1" as="geometry" /></mxCell>
