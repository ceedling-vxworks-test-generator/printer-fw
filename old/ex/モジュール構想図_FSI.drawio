        <mxCell id="lMu2XPO0y1B0d5oH1q_r-227" value="HeartBeatについては、&lt;div&gt;周期通知を受けて生存確認をする別タスクが外部にいるべきである。&lt;/div&gt;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#f8cecc;strokeColor=#b85450;position2=0.24;" parent="lMu2XPO0y1B0d5oH1q_r-223" vertex="1">
