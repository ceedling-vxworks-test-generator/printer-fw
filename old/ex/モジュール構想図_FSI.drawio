        <mxCell id="lMu2XPO0y1B0d5oH1q_r-84" value="&lt;div&gt;🔵 PeriodicTimer&lt;br&gt;✅ 周期発火(連続値の定期表示)&lt;/div&gt;&lt;div&gt;❌ バースト抑制は「&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Rate Limiter&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;」で対応&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;align=left;verticalAlign=top;" parent="lMu2XPO0y1B0d5oH1q_r-83" vertex="1">
