        <mxCell id="lMu2XPO0y1B0d5oH1q_r-6" value="RIM_PublisherLayer（配信専用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F1FF;strokeColor=#2D6CDF;align=left;verticalAlign=top;fontSize=12;fontStyle=1;arcSize=4;" parent="lMu2XPO0y1B0d5oH1q_r-1" vertex="1">
