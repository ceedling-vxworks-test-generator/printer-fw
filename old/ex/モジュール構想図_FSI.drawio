        </mxCell>
        <mxCell id="lMu2XPO0y1B0d5oH1q_r-85" value="Periodic周期発火" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" parent="lMu2XPO0y1B0d5oH1q_r-83" vertex="1">
