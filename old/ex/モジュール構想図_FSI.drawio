          <mxGeometry x="132.5" y="60" width="117.5" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lMu2XPO0y1B0d5oH1q_r-120" value="取得" style="curved=1;endArrow=classic;html=1;rounded=0;strokeWidth=3;strokeColor=#d79b00;entryX=0.5;entryY=0;entryDx=0;entryDy=0;shape=flexArrow;exitX=1;exitY=1;exitDx=0;exitDy=0;fillColor=#ffe6cc;" parent="lMu2XPO0y1B0d5oH1q_r-12" source="lMu2XPO0y1B0d5oH1q_r-122" target="lMu2XPO0y1B0d5oH1q_r-10" edge="1">
          <mxGeometry x="0.1317" y="4" width="50" height="50" relative="1" as="geometry">
            <mxPoint x="-340" y="-440" as="sourcePoint" />
            <mxPoint x="1237.499999999999" y="50" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lMu2XPO0y1B0d5oH1q_r-204" value="&lt;div&gt;&lt;div&gt;前提：&lt;/div&gt;&lt;div&gt;- Domain Data Storeを入力源とする&lt;/div&gt;&lt;/div&gt;&lt;div&gt;-&amp;nbsp;CapabilityはDataStoreの値から決定される補助的な実行状態であり再計算可能である&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;✅ やる:&amp;nbsp;&lt;div&gt;&lt;div&gt;- 入力データから直接導出される状態変換（意味化(名詞)）&lt;/div&gt;&lt;div&gt;- 判定式の適用&lt;/div&gt;&lt;div&gt;- 判定結果の派生イベント発行&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;❌ やらない:&amp;nbsp;&lt;/div&gt;&lt;div&gt;- 状態の永続保持・配信・動作の実行・判定以外のロジック&lt;/div&gt;&lt;div&gt;&lt;div&gt;- 複雑な業務判断&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;fontSize=10;fontStyle=2;fontColor=#2D6CDF;" parent="lMu2XPO0y1B0d5oH1q_r-12" vertex="1">
          <mxGeometry x="-1100" y="860" width="765" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lMu2XPO0y1B0d5oH1q_r-208" value="Publish (登録購読者へ)&#xa;OnChange / Periodic / Heartbeat&#xa;Threshold / Event / Initial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E6;strokeColor=#FF8C00;fontSize=10;align=center;fontStyle=1;fontColor=#FF8C00;" parent="lMu2XPO0y1B0d5oH1q_r-12" vertex="1">
          <mxGeometry x="-140" y="-220" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lMu2XPO0y1B0d5oH1q_r-21" value="" style="group;strokeColor=none;" parent="lMu2XPO0y1B0d5oH1q_r-12" vertex="1" connectable="0">
          <mxGeometry x="-230" y="580" width="450" height="180" as="geometry" />
        </mxCell>
        <mxCell id="lMu2XPO0y1B0d5oH1q_r-4" value="Data Store Layer（正規化された値(観測事実)の保持）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2CE;strokeColor=light-dark(#7a9173, #6399fc);align=left;verticalAlign=top;fontSize=12;fontStyle=1;arcSize=6;" parent="lMu2XPO0y1B0d5oH1q_r-12" vertex="1">
          <mxGeometry x="-1100" y="1580" width="2040" height="1140" as="geometry" />
        </mxCell>
        <mxCell id="lMu2XPO0y1B0d5oH1q_r-209" value="✅ やる:&amp;nbsp;&lt;div&gt;- RIM_CapabilityLayerおよびAccessor Layerにデータを提供する&lt;br&gt;&lt;div&gt;- RIM_AdapterLayer入力（センサ値およびイベント由来データ等）の保持&lt;/div&gt;&lt;div&gt;- 差分検知&lt;/div&gt;&lt;div&gt;- Mutexによる並行性制御&amp;nbsp;&lt;/div&gt;&lt;div&gt;❌ やらない:&amp;nbsp;&lt;/div&gt;&lt;div&gt;- 値の解釈・配信・判断・入力源変換 (それはRIM_AdapterLayer)&lt;/div&gt;&lt;/div&gt;&lt;div&gt;- 保存するデータに状態は含まない(それはRIM_CapabilityLayer)&lt;/div&gt;" style="text;html=1;align=left;fontSize=10;fontStyle=2;fontColor=#2D6CDF;" parent="lMu2XPO0y1B0d5oH1q_r-12" vertex="1">
          <mxGeometry x="-1090" y="1610" width="695" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lMu2XPO0y1B0d5oH1q_r-60" value="&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;🔵&lt;/span&gt;Domain&amp;nbsp;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Data&lt;/span&gt;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;Store&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;✅&lt;/span&gt;14カテゴリ×Tier保持、データの整合性保証、各データを保持（必要ならばそのtimestampも）、カテゴリ別ミューテックス保持&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 10px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;❌ &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;値の解釈/編集はしない&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=label;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;align=left;verticalAlign=top;fillColor=#C4D5C3;strokeColor=#6C8EBF;rounded=0;" parent="lMu2XPO0y1B0d5oH1q_r-12" vertex="1">
