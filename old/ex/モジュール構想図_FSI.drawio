        <mxCell id="lMu2XPO0y1B0d5oH1q_r-229" value="① State Repository (最終配信値・差分管理)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;align=left;verticalAlign=top;fontSize=11;fontStyle=1;" parent="lMu2XPO0y1B0d5oH1q_r-228" vertex="1">
          <mxGeometry width="285" height="180" as="geometry" />
        </mxCell>
        <mxCell id="lMu2XPO0y1B0d5oH1q_r-230" value="🔵 Last-Known State Cache&#xa;✅ 各購読者の最終配信値・配信時刻保持&#xa;❌ 全購読者横断の集計はしない" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="lMu2XPO0y1B0d5oH1q_r-228" vertex="1">
