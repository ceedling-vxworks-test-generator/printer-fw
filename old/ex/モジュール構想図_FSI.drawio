        </mxCell>
        <mxCell id="lMu2XPO0y1B0d5oH1q_r-232" value="ステータスが必要なところで定義してもらうため保持しない" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#f8cecc;strokeColor=#b85450;position2=0.37;" parent="lMu2XPO0y1B0d5oH1q_r-228" vertex="1">
