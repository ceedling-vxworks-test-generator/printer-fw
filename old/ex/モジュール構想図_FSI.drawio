        </mxCell>
        <mxCell id="lMu2XPO0y1B0d5oH1q_r-87" value="🔵 Rate Limiter (Throttler)（定期配信のトリガ管理）&lt;br&gt;✅&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;Capabilityごとに配信頻度を制御、&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;最新状態を配信&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;❌ データ内容の意味は変更しない（更新の間引きのみ行う）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;align=left;verticalAlign=top;" parent="lMu2XPO0y1B0d5oH1q_r-86" vertex="1">
          <mxGeometry width="390" height="100" as="geometry" />
        </mxCell>
