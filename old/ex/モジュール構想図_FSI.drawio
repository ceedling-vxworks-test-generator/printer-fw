        </mxCell>
        <mxCell id="lMu2XPO0y1B0d5oH1q_r-233" value="更新時に変更のある項目はわかる(L3)ため前回値は保持しない" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#f8cecc;strokeColor=#b85450;position2=0.47;" parent="lMu2XPO0y1B0d5oH1q_r-228" vertex="1">
