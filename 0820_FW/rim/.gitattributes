# すべてのテキストファイルの改行コードを LF に正規化する
* text=auto eol=lf

# バイナリファイル
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# C / C++ ソース
*.c   text eol=lf
*.h   text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf

# ビルドシステム
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# CI / DevContainer
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh   text eol=lf

# ドキュメント
*.md  text eol=lf
*.txt text eol=lf
Doxyfile text eol=lf
