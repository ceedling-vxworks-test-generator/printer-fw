{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: configure mainfw-mock",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": [],
            "detail": "mainfw-mock単体のconfigure。printer-fwのビルドは一切行わない。lib/・include/が無くても configure 自体は通る(警告のみ)。"
        },
        {
            "label": "cmake: build mainfw_mock",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--target", "mainfw_mock"
            ],
            "dependsOn": "cmake: configure mainfw-mock",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "mainfw_mock実行ファイルをビルドする。lib/librimanager.so・include/rim_api.h 等が置かれていなければ、コンパイル/リンクエラーで失敗する(意図した挙動)。"
        },
        {
            "label": "printer-fw: build & vendor into lib/ include/ (手動・任意)",
            "type": "shell",
            "command": "sh",
            "args": [
                "-c",
                "cmake -S ${workspaceFolder}/.. -B ${workspaceFolder}/../build-shared -DCMAKE_BUILD_TYPE=Debug -DRIMANAGER_BUILD_TESTS=OFF && cmake --build ${workspaceFolder}/../build-shared --target rimanager && cmake --install ${workspaceFolder}/../build-shared --prefix ${workspaceFolder}"
            ],
            "problemMatcher": ["$gcc"],
            "detail": "printer-fwをビルドし、mainfw-mock/lib・includeへ配置するヘルパー。ライブラリを更新したいときにコマンドパレットから明示的に実行すること(build/デバッグの自動チェーンには含めない)。"
        }
    ]
}
