        <mxCell id="NMfPxW1A1fzgvZb7g0Rw-24" value="&lt;span&gt;Adapter&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;Layer&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;（データの取得と正規化）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F1FF;strokeColor=light-dark(#2D6CDF,#6399FC);align=left;verticalAlign=top;fontSize=12;fontStyle=1;arcSize=6;" parent="1" vertex="1">
