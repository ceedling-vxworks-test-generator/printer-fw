        </mxCell>
        <mxCell id="NMfPxW1A1fzgvZb7g0Rw-44" value="UI&#xa;(操作パネル/タッチスクリーン)&#xa;&#xa;✅ やる:&#xa;・Capability変化を画面表示&#xa;・ユーザ要求を駆動軸へ送出&#xa;❌ やらない:&#xa;・状態保持/判断" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="-1294.25" y="-1030" width="335" height="140" as="geometry" />
        </mxCell>
        <mxCell id="NMfPxW1A1fzgvZb7g0Rw-45" value="Logger&#xa;(動作ログ・履歴記録)&#xa;&#xa;✅ やる:&#xa;・購読イベントの保存&#xa;・ローテーション/圧縮&#xa;❌ やらない:&#xa;・能動的なI/O" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1">
