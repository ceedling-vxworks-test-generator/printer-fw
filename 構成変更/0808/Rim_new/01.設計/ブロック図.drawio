        <mxCell id="NMfPxW1A1fzgvZb7g0Rw-20" value="Publisher Layer（配信専用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F1FF;strokeColor=#2D6CDF;align=left;verticalAlign=top;fontSize=12;fontStyle=1;arcSize=4;" parent="1" vertex="1">
