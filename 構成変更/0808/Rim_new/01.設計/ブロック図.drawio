          <mxGeometry x="-705" y="200" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="NMfPxW1A1fzgvZb7g0Rw-88" value="🔵 ConsumableCap&#xa;インク/ワイパー残量" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="-710" y="360" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="NMfPxW1A1fzgvZb7g0Rw-89" value="🔵 SafetyCap&#xa;カバー/E-STOP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="-710" y="390" width="100" height="30" as="geometry" />
