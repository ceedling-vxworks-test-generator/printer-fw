        <mxCell id="NMfPxW1A1fzgvZb7g0Rw-90" value="🔵 JobCap&#xa;ジョブ進捗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="-710" y="510" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="NMfPxW1A1fzgvZb7g0Rw-91" value="🔵 ErrorCap&#xa;エラー集約" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="-710" y="540" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="NMfPxW1A1fzgvZb7g0Rw-92" value="🔵 MaintCap&#xa;メンテ要否" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="-710" y="450" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="NMfPxW1A1fzgvZb7g0Rw-93" value="🔵 EnvCap&#xa;温湿度範囲" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="-710" y="480" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="EgCWCpkiBOTJqwDk34iA-14" value="■データの保存について、L2L3からStorage Layerに分離&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;従来案：CapabilityについてはCapability Layer、DataについてはDataStora Layerに保持&lt;/div&gt;&lt;div&gt;修正案：Storage Layerを新設し、保持の責務を集約&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;取得について、DataStoreLayerへの直接アクセスは避けたい。&lt;/div&gt;&lt;div&gt;そこで従来の層を①データの変更検知などを責務とする層、②保持を責務とする層の２種類の分けた。&lt;/div&gt;&lt;div&gt;これにより、②へのアクセス自体は許容する設計とした。&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="1360" y="-830" width="389.37" height="155" as="geometry" />
        </mxCell>
        <mxCell id="NMfPxW1A1fzgvZb7g0Rw-169" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(45, 108, 223), rgb(99, 153, 252));&quot;&gt;✅ やる:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;- DataおよびCapabilityの現在値を保持&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(45, 108, 223), rgb(99, 153, 252));&quot;&gt;❌ やらない:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;- 状態変化の検知&lt;/div&gt;" style="text;html=1;align=left;fontSize=10;fontStyle=2;fontColor=#2D6CDF;" parent="1" vertex="1">
          <mxGeometry x="1150" y="-760" width="290" height="20" as="geometry" />
